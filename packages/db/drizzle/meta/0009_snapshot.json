        "gifts_status": {
          "name": "gifts_status",
          "value": "\"gifts\".\"status\" in ('packed', 'sent', 'received', 'taken_out', 'returned')"
        },
        "gifts_escrow_status": {
          "name": "gifts_escrow_status",
          "value": "\"gifts\".\"escrow_status\" in ('missing', 'pending', 'claimed', 'rejected', 'expired_returned')"
        },
        "gifts_status_dates": {
          "name": "gifts_status_dates",
          "value": "(\"gifts\".\"status\" = 'packed' and \"gifts\".\"sent_at\" is null and \"gifts\".\"received_at\" is null and \"gifts\".\"taken_out_at\" is null and \"gifts\".\"returned_at\" is null)\n        or (\"gifts\".\"status\" = 'sent' and \"gifts\".\"sent_at\" is not null and \"gifts\".\"received_at\" is null and \"gifts\".\"taken_out_at\" is null and \"gifts\".\"returned_at\" is null)\n        or (\"gifts\".\"status\" = 'received' and \"gifts\".\"received_at\" is not null and \"gifts\".\"taken_out_at\" is null and \"gifts\".\"returned_at\" is null)\n        or (\"gifts\".\"status\" = 'taken_out' and \"gifts\".\"taken_out_at\" is not null and \"gifts\".\"received_at\" is null and \"gifts\".\"returned_at\" is null)\n        or (\"gifts\".\"status\" = 'returned' and \"gifts\".\"returned_at\" is not null and \"gifts\".\"taken_out_at\" is null)"
        },
        "gifts_status_escrow": {
          "name": "gifts_status_escrow",
          "value": "(\"gifts\".\"status\" = 'packed' and \"gifts\".\"escrow_status\" in ('missing', 'pending'))\n        or (\"gifts\".\"status\" = 'sent' and \"gifts\".\"escrow_status\" = 'pending')\n        or (\"gifts\".\"status\" = 'received' and \"gifts\".\"escrow_status\" in ('pending', 'claimed'))\n        or (\"gifts\".\"status\" = 'taken_out' and \"gifts\".\"escrow_status\" in ('missing', 'pending', 'rejected'))\n        or (\"gifts\".\"status\" = 'returned' and \"gifts\".\"escrow_status\" in ('pending', 'expired_returned'))"
        },
        "gifts_receiver": {
          "name": "gifts_receiver",
          "value": "(\"gifts\".\"receiver_id\" is null) = (\"gifts\".\"received_at\" is null)"
        },
        "gifts_not_to_self": {
          "name": "gifts_not_to_self",
          "value": "\"gifts\".\"receiver_id\" is null or \"gifts\".\"receiver_id\" <> \"gifts\".\"giver_id\""
        },
        "gifts_expiry": {
          "name": "gifts_expiry",
          "value": "\"gifts\".\"expires_at\" > \"gifts\".\"created_at\""
        },
        "gifts_transactions": {
          "name": "gifts_transactions",
          "value": "(\"gifts\".\"claim_tx_hash\" is null or \"gifts\".\"received_at\" is not null)\n        and (\"gifts\".\"reject_tx_hash\" is null or \"gifts\".\"status\" = 'taken_out')\n        and (\"gifts\".\"return_tx_hash\" is null or \"gifts\".\"status\" = 'returned')"
        },
        "gifts_pushed": {
          "name": "gifts_pushed",
          "value": "\"gifts\".\"pushed_to_giver_at\" is null or \"gifts\".\"received_at\" is not null"
        }

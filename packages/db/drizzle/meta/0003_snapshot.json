        "gifts_claim_commitment": {
          "name": "gifts_claim_commitment",
          "value": "length(\"gifts\".\"claim_commitment\") = 66 and \"gifts\".\"claim_commitment\" like '0x%'"
        },
        "gifts_status": {
          "name": "gifts_status",
          "value": "\"gifts\".\"status\" in ('packed', 'sent', 'received', 'taken_out', 'returned')"
        },
        "gifts_escrow_status": {
          "name": "gifts_escrow_status",
          "value": "\"gifts\".\"escrow_status\" in ('missing', 'pending', 'claimed', 'taken_out', 'expired_returned')"
        },
        "gifts_status_dates": {
          "name": "gifts_status_dates",
          "value": "(\"gifts\".\"status\" = 'packed' and \"gifts\".\"sent_at\" is null and \"gifts\".\"received_at\" is null and \"gifts\".\"taken_out_at\" is null and \"gifts\".\"returned_at\" is null)\n        or (\"gifts\".\"status\" = 'sent' and \"gifts\".\"sent_at\" is not null and \"gifts\".\"received_at\" is null and \"gifts\".\"taken_out_at\" is null and \"gifts\".\"returned_at\" is null)\n        or (\"gifts\".\"status\" = 'received' and \"gifts\".\"received_at\" is not null and \"gifts\".\"taken_out_at\" is null and \"gifts\".\"returned_at\" is null)\n        or (\"gifts\".\"status\" = 'taken_out' and \"gifts\".\"taken_out_at\" is not null and \"gifts\".\"received_at\" is null and \"gifts\".\"returned_at\" is null)\n        or (\"gifts\".\"status\" = 'returned' and \"gifts\".\"returned_at\" is not null and \"gifts\".\"received_at\" is null and \"gifts\".\"taken_out_at\" is null)"
        },
        "gifts_status_escrow": {
          "name": "gifts_status_escrow",
          "value": "(\"gifts\".\"status\" = 'packed' and \"gifts\".\"escrow_status\" in ('missing', 'pending'))\n        or (\"gifts\".\"status\" = 'sent' and \"gifts\".\"escrow_status\" = 'pending')\n        or (\"gifts\".\"status\" = 'received' and \"gifts\".\"escrow_status\" = 'claimed')\n        or (\"gifts\".\"status\" = 'taken_out' and \"gifts\".\"escrow_status\" in ('missing', 'taken_out'))\n        or (\"gifts\".\"status\" = 'returned' and \"gifts\".\"escrow_status\" in ('pending', 'expired_returned'))"
        },
        "gifts_receiver": {
          "name": "gifts_receiver",
          "value": "(\"gifts\".\"receiver_id\" is null) = (\"gifts\".\"received_at\" is null)"
        },
        "gifts_not_to_self": {
          "name": "gifts_not_to_self",
          "value": "\"gifts\".\"receiver_id\" is null or \"gifts\".\"receiver_id\" <> \"gifts\".\"giver_id\""
        },
        "gifts_not_for_self": {
          "name": "gifts_not_for_self",
          "value": "\"gifts\".\"for_user_id\" is null or \"gifts\".\"for_user_id\" <> \"gifts\".\"giver_id\""
        },
        "gifts_expiry": {
          "name": "gifts_expiry",
          "value": "\"gifts\".\"expires_at\" > \"gifts\".\"created_at\""
        },
        "gifts_pushed": {
          "name": "gifts_pushed",
          "value": "\"gifts\".\"pushed_to_giver_at\" is null or \"gifts\".\"received_at\" is not null"
        }

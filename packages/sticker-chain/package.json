    "lint": "oxlint .",
    "start:auth": "tsx src/start-auth-server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@wagmi/cli": "2.2.0",
    "@types/node": "24.13.3",
    "ganache": "7.9.2",
    "oxlint": "1.81.0",
    "solc": "0.8.37",
    "tsx": "4.20.6",
    "typescript": "6.0.2",
    "vitest": "4.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}

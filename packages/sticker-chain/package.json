{
  "name": "@drawing-app/sticker-chain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth-http": "./src/auth-http.ts",
    "./bytes32": "./src/bytes32.ts",
    "./contracts": "./src/generated/contracts.ts",
    "./croquis-names": "./src/croquis-names.ts",
    "./ens-gateway": "./src/ens-gateway.ts",
    "./gift-sticker": "./src/gift-sticker.ts",
    "./line": "./src/line.ts",
    "./line-privy-jwt": "./src/line-privy-jwt.ts",
    "./seal-sticker": "./src/seal-sticker.ts"
  },
  "scripts": {
    "build": "pnpm generate-types",
    "build:auth-server": "rm -rf dist/auth-server && tsc src/start-auth-server.ts --ignoreConfig --outDir dist/auth-server --module nodenext --moduleResolution nodenext --target es2023 --strict --skipLibCheck --types node && echo '{\"type\":\"module\"}' > dist/auth-server/package.json",
    "compile": "forge build",
    "generate-types": "pnpm compile && wagmi generate",
    "lint": "oxlint src test wagmi.config.ts",
    "test": "pnpm test:contracts && pnpm test:backend",
    "test:backend": "vitest run",
    "test:contracts": "forge test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@wagmi/cli": "2.10.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}

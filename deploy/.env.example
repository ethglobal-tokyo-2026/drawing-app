# Copy to deploy/.env. The SSH login on the box that serves the LIFF endpoint.
DEPLOY_TARGET=user@host
# Optional: the public address the deploy checks.
# DEPLOY_URL=https://sticker.195-201-8-147.sslip.io
# Optional: the CDN in front of the box, which the app loads its hashed files from (deploy/README.md's CDN).
# CDN_ORIGIN=https://<distribution>.cloudfront.net

# What the box's mode-600 chain.env holds. deploy-api.sh installs these there, with STICKER_CHAIN_MODE=sui, and nothing
# else: each is required, and a missing or invalid one aborts the deploy before anything is published. The stickers
# package's public IDs are in deploy/drawing-api.env.
# The server's Sui key, suiprivkey1… (`sui keytool export`). It sends mints, claims and expiry returns, and holds no
# SUI: Shinami Gas Station pays all gas, through this access key.
SUI_SERVER_PRIVATE_KEY=
SHINAMI_ACCESS_KEY=
# Privy's app, through which the API reads each person's Sui wallet.
PRIVY_APP_ID=cmuh4s0lz01fn0cl143lomlzj
PRIVY_APP_SECRET=
# The Messaging API channel, for the chat menu and the giver's message.
LINE_MESSAGING_CHANNEL_ID=
LINE_MESSAGING_CHANNEL_SECRET=

# Deploy only, never on the box: the key deploy/publish-sui.mjs publishes the stickers package from (suiprivkey1…),
# whose address holds the package's AdminCap, UpgradeCap and DisplayCap.
SUI_DEPLOYER_PRIVATE_KEY=

# DEPLOY_ENV_FILE can point to another gitignored deployment environment file.

# Copy to deploy/.env. The SSH login on the box that serves the LIFF endpoint.
DEPLOY_TARGET=user@host
# Optional: the public address the deploy checks.
# DEPLOY_URL=https://sticker.195-201-8-147.sslip.io
# Optional, for the chat menu and the giver's message: the Messaging API channel's ID and secret.
# deploy-api.sh installs them in the REST API's mode-600 chain.env; without them, the API links no
# chat menu and sends givers no message.
# LINE_MESSAGING_CHANNEL_ID=
# LINE_MESSAGING_CHANNEL_SECRET=
# Optional, for age verification: the World ID app's app ID, RP ID and RP signing key, from World's
# Developer Portal (https://developer.world.org). deploy-api.sh installs them in chain.env; without
# them, age verification is off.
# WORLD_ID_APP_ID=
# WORLD_ID_RP_ID=
# WORLD_ID_SIGNING_KEY=

# Ethereum Sepolia NFT and escrow deployment. deploy-api.sh installs these in the box's mode-600 chain.env, except
# DEPLOYER_PRIVATE_KEY and ENS_GATEWAY_URL: only deploy-contracts.sh reads those, so they stay here.
# PRIVY_APP_ID=cmuh4s0lz01fn0cl143lomlzj
# PRIVY_APP_SECRET=
# One RPC URL, or several separated by commas, which the REST API tries in turn: free RPCs each refuse
# something, e.g. https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.gateway.tenderly.co
# ETHEREUM_SEPOLIA_RPC_URL=
# DEPLOYER_PRIVATE_KEY=
# STICKER_SEALER_PRIVATE_KEY=
# STICKER_NFT_ADDRESS=
# STICKER_GIFT_ESCROW_ADDRESS=
# The names under croquis.eth. deploy-contracts.sh prints both addresses. The gateway key signs the
# API's CCIP-Read answers; its address is the one CroquisResolver trusts, set at deploy.
# CROQUIS_NAMES_ADDRESS=
# CROQUIS_RESOLVER_ADDRESS=
# ENS_GATEWAY_PRIVATE_KEY=
# ENS_GATEWAY_URL=https://sticker.195-201-8-147.sslip.io/api/ens/gateway/{sender}/{data}.json
# Optional public browser RPC. Never reuse a private backend RPC credential here.
# VITE_STICKER_RPC_URL=https://public-sepolia-rpc.example
# deploy-api.sh keeps the values already in the server's chain.env that this file leaves out.
# Incomplete configuration aborts before publishing.
# DEPLOY_ENV_FILE can point to another gitignored deployment environment file.

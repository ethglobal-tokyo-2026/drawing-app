# Copy to deploy/.env. The SSH login on the box that serves the LIFF endpoint.
DEPLOY_TARGET=user@host
# Optional: where the site lives on the box, and the public address the deploy checks.
# DEPLOY_DIR=/srv/sticker-board
# DEPLOY_URL=https://sticker.195-201-8-147.sslip.io
# Optional, for chat menu switching: Privy's app secret and the Messaging API channel's ID and secret.
# deploy.sh installs them on the box as /srv/sticker-auth/secrets.env (mode 600).
# PRIVY_APP_SECRET=
# LINE_MESSAGING_CHANNEL_ID=
# LINE_MESSAGING_CHANNEL_SECRET=

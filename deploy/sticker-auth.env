# Config for the LINE → Privy auth server (deploy/sticker-auth.service). All of it is public; no secret goes here.
# The signing key is made on the box by deploy.sh and never leaves it. The chat menu switch's secrets
# come from the gitignored deploy/.env, which deploy.sh installs on the box as secrets.env.
LINE_CHANNEL_ID=2011732197
PRIVY_APP_ID=cmuh4s0lz01fn0cl143lomlzj
AUTH_ISSUER=https://sticker.195-201-8-147.sslip.io
AUTH_SIGNING_KEY_FILE=/srv/sticker-auth/signing-key.pem
AUTH_KEY_ID=sticker-auth-1
APP_ORIGIN=https://sticker.195-201-8-147.sslip.io
HOST=127.0.0.1
PORT=8787
# The returning-user chat menu in each language, made by deploy/line/create-returning-menu.sh en|ja. Not secret.
# Without _JA, Japanese gets the English menu.
LINE_RETURNING_RICH_MENU_ID_EN=richmenu-c6504badb49f4c4d99a9da34f93baae0

# Config for the REST API (deploy/drawing-api.service). All of it is public; no secret goes here.
# The session cookie's secret is made on the box by deploy-api.sh, in secrets.env, and never leaves it.
LINE_CHANNEL_ID=2011732197
IMAGE_DIR=/srv/drawing-api/images
# Where the box serves the sticker images. An NSFW sticker's drawing always loads from here, since only the box
# sees the session; with CDN_BASE_URL set, every other image loads from the CDN in front of it (deploy/README.md).
IMAGE_BASE_URL=https://stickeroo.art/api/images
CDN_BASE_URL=https://stickeroo.global.ssl.fastly.net/api/images
DATABASE_URL=/srv/drawing-api/data/drawing-app.db
PORT=8788
# The Sui network the API uses, and the ticket shop's JPYC and payment contract on it: all public.
SUI_NETWORK=testnet
JPYC_COIN_TYPE=0xf239f4711b8b6e5331a24174905e8412df01e6fe81abcdaa2613f5aaf35a6496::jpy_coin::JPY_COIN
JPYC_DECIMALS=6
JPYC_PAYMENT_PACKAGE=0xce54032ee3ee017f6cc5bcb64393a246c2d1250717dc5c1963f6b4c578f70aa5
JPYC_PAYMENT_VAULT=0x5198edbb873bc4d2f139c97be8c18784f997f92be784a715ec0239bf2295b97c
# The stickers package on that network, as deploy/publish-sui.mjs prints its IDs. deploy-api.sh stops while one is blank.
SUI_STICKER_PACKAGE=0xf9459a861fb5aa97ac6bb3e7542abe6096163ce05ec85e2ca2e2b0ca0696b505
SUI_STICKER_REGISTRY=0xed739960e58f9d638193ab7e9019ad5e91e236b594a85ee2c3347a48d41ac0f1
SUI_SERVER_CONFIG=0x4dd5f1a14ba0cbd80365b9a0921c46d5cdc8ea8ba1ef1abdfbb8ff383a96a85e
SUI_GIFT_ESCROW=0x4d6f33314377c79663d148d3234774c21129215eeeb7c7908808ce8e902fc6f7
# The chat menus' IDs: deploy/line/menus.json, which deploy-api.sh copies here.
LINE_CHAT_MENUS_FILE=/srv/drawing-api/line-menus.json
# The Sui server key, Shinami's access key, Privy's values and the chat menu's Messaging API channel are installed from
# the gitignored deploy/.env into chain.env.

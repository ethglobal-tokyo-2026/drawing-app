# Config for the REST API (deploy/drawing-api.service). All of it is public; no secret goes here.
# The session cookie's secret is made on the box by deploy-api.sh, in secrets.env, and never leaves it.
LINE_CHANNEL_ID=2011732197
IMAGE_DIR=/srv/drawing-api/images
CDN_BASE_URL=https://sticker.195-201-8-147.sslip.io/api/images
DATABASE_URL=/srv/drawing-api/data/drawing-app.db
PORT=8788
SUI_NETWORK=testnet
# The ticket shop's JPYC and payment contract on Sui.
JPYC_COIN_TYPE=0xf239f4711b8b6e5331a24174905e8412df01e6fe81abcdaa2613f5aaf35a6496::jpy_coin::JPY_COIN
JPYC_DECIMALS=6
JPYC_PAYMENT_PACKAGE=0xce54032ee3ee017f6cc5bcb64393a246c2d1250717dc5c1963f6b4c578f70aa5
JPYC_PAYMENT_VAULT=0x5198edbb873bc4d2f139c97be8c18784f997f92be784a715ec0239bf2295b97c
# The stickers package on Sui and its shared objects, as deploy/publish-sui.mjs prints them.
SUI_STICKER_PACKAGE=
SUI_STICKER_REGISTRY=
SUI_SERVER_CONFIG=
SUI_GIFT_ESCROW=
# The chat menus' IDs: deploy/line/menus.json, which deploy-api.sh copies here.
LINE_CHAT_MENUS_FILE=/srv/drawing-api/line-menus.json
# chain.env, which deploy-api.sh installs from the gitignored deploy/.env, holds STICKER_CHAIN_MODE=sui and the
# secrets: the server's Sui key, Shinami's access key, Privy's app and the Messaging API channel.

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["journalctl", "uv"],
  "workspaces": {
    ".": {
      "entry": ["deploy/*.mjs"],
      "ignoreBinaries": ["sui"],
      "ignoreDependencies": ["@mysten/sui"]
    },
    "apps/frontend": {
      "entry": ["e2e/thoughtReview.tsx"],
      "vite": { "config": ["vite.config.ts", "e2e/vite.config.ts", "vite.demo.config.ts"] },
      "playwright": {
        "config": [
          "playwright.config.ts",
          "playwright.performance.config.ts",
          "playwright.stored-stickers.config.ts"
        ]
      }
    },
    "packages/line-auth": {
      "entry": ["src/start-auth-server.ts"],
      "project": ["**/*.{js,mjs,cjs,ts,mts,cts}"]
    }
  }
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["forge", "anvil", "journalctl", "uv"],
  "workspaces": {
    ".": {
      "entry": ["deploy/*.mjs"]
    },
    "packages/sticker-chain": {
      "entry": ["wagmi.config.ts", "src/start-auth-server.ts"],
      "project": ["**/*.{js,mjs,cjs,ts,mts,cts}", "!lib/**"],
      "ignoreDependencies": ["@openzeppelin/contracts"]
    }
  }
}

@@ -0,0 +1,22 @@
+/** Pinned CSP table 0x10451cbd8, entries 0–90; extracted bytes recorded in spikes/post-input/evidence/manifest.json. */
+export const startupSineTable: readonly number[] = [
+  0.0, 0.0174524064372835, 0.034899496702501, 0.0523359562429438, 0.0697564737441253,

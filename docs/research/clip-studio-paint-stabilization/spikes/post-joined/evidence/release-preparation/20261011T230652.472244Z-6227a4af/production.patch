+++ b/apps/frontend/src/sticker-creation/canvas/post-correction/core.test.ts
@@ -0,0 +1,186 @@
+import { describe, expect, it } from "vitest";
+import { correctPostStroke, transferStrokeAttributes, type PostCorrectionInput } from "./core";
+import { FIRST_POST_CORRECTION } from "./settings";
+import { PostCorrectionError } from "./errors";
+import { Stabilizer } from "../stabilizer";
+
+const input = (overrides: Partial<PostCorrectionInput> = {}): PostCorrectionInput => ({
+  packets: [
+    { x: 0, y: 0, pressure: 0.5, t: 10, phase: 2 },
+    { x: 20, y: 0, pressure: 0.5, t: 20, phase: 1 },
+    { x: 40, y: 0, pressure: 0, t: 30, phase: 3 },
+  ],
+  renderedPoints: [0, 0, 2, 0, 20, 0, 4, 10, 40, 0, 3, 20],
+  settings: { ...FIRST_POST_CORRECTION, strength: 5 },
+  magnificationFraction: 1,
+  brushSize: 7,
+  pointerType: "pen",
+  stabilization: 20,
+  ...overrides,
+});
+
+describe("post-correction core", () => {
+  it("runs all completed packets through recovered source construction and samples the corrected spline directly", () => {
+    const source = input();
+    const before = structuredClone(source);
+    const result = correctPostStroke(source);
+    expect(result.sourceNodeCount).toBe(3);
+    expect(result.correctedNodeCount).toBeGreaterThanOrEqual(2);
+    expect(result.points.slice(0, 4)).toEqual([0, 0, 2, 0]);
+    expect(result.points.slice(-4)).toEqual([40, 0, 3, 20]);
+    expect(result.points.length).toBeGreaterThan(12);
+    for (let i = 1; i < result.points.length; i += 4) expect(result.points[i]).toBe(0);
+    expect(source).toEqual(before);
+  });
+
+  it("disabled correction preserves existing rendered points without sharing the mutable array", () => {
+    const source = input({ settings: FIRST_POST_CORRECTION });
+    const result = correctPostStroke(source);
+    expect(result.points).toEqual(source.renderedPoints);
+    expect(result.points).not.toBe(source.renderedPoints);
+  });
+
+  it("requires an explicit terminal phase and never treats the last contact as finalization", () => {
+    const packets = input().packets.slice(0, -1);
+    expect(() => correctPostStroke(input({ packets }))).toThrow(/phase sequence/);
+    const ended = [...packets, { ...packets[1], phase: 3 as const }];
+    expect(correctPostStroke(input({ packets: ended })).sourceNodeCount).toBe(3);
+    expect(() => correctPostStroke(input({ packets: [ended[0], ended[0], ended[2]] }))).toThrow(
+      /phase sequence/,
+    );
+    expect(() => correctPostStroke(input({ packets: ended.slice(1) }))).toThrow(/phase sequence/);
+    expect(() => correctPostStroke(input({ packets: [...ended, ended[0]] }))).toThrow(
+      /phase sequence/,
+    );
+    const unknown = structuredClone(ended);
+    Reflect.set(unknown[1], "phase", 4);
+    expect(() => correctPostStroke(input({ packets: unknown }))).toThrow(/phase sequence/);
+  });
+
+  it("retains idle release coordinates after a zero-pressure native ending without fabricating another source group", () => {
+    for (const stabilization of [0, 4, 20, 100]) {
+      for (const pressure of stabilization === 0 ? [0, 0.5] : [0]) {
+        const stabilizer = new Stabilizer({ x: 0, y: 0, pressure, t: 100 }, stabilization, true);
+        const packets = [
+          stabilizer.initial,
+          ...stabilizer.add({ x: 20, y: 0, pressure: 0, t: 104 }),
+          ...stabilizer.finish({ x: 40, y: 0, pressure: 0, t: 108 }),
+        ];
+        expect(packets.map((packet) => packet.phase)).toEqual(
+          stabilization === 0 ? [2, 3, 3] : [2, 3, 1],
+        );
+        const renderedPoints = [0, 0, 2, 0, 20, 0, 1, 4, 40, 0, 0, 8];
+        const result = correctPostStroke(input({ packets, stabilization, renderedPoints }));
+        const group = correctPostStroke(
+          input({
+            packets: packets.slice(0, 2),
+            stabilization,
+            renderedPoints: [0, 0, 2, 0, packets[1].x, packets[1].y, 1, 4],
+          }),
+        ).points;
+        const geometry = Array.from({ length: group.length / 4 }, (_, index) => ({
+          x: group[index * 4],
+          y: group[index * 4 + 1],
+        }));
+        geometry.push({ x: packets[2].x, y: packets[2].y });
+        expect(result.points).toEqual(transferStrokeAttributes(geometry, renderedPoints));
+        expect(result.sourceNodeCount).toBe(2);
+        expect(result.points.slice(-4)).toEqual([packets[2].x, packets[2].y, 0, 8]);
+      }
+    }
+  });
+
+  it("corrects zero-pressure startup and resumed contact as explicit native groups within one result", () => {
+    for (const stabilization of [0, 4, 20, 100]) {
+      const stabilizer = new Stabilizer({ x: 0, y: 0, pressure: 0, t: 100 }, stabilization, true);
+      const packets = [
+        stabilizer.initial,
+        ...stabilizer.add({ x: 20, y: 0, pressure: 0, t: 104 }),
+        ...stabilizer.add({ x: 40, y: 12, pressure: 0.5, t: 108 }),
+        ...stabilizer.finish({ x: 60, y: 20, pressure: 0, t: 112 }),
+      ];
+      expect(packets.filter((packet) => packet.phase === 2)).toHaveLength(2);
+      expect(packets.filter((packet) => packet.phase === 3)).toHaveLength(2);
+      const renderedPoints = [0, 0, 0, 0, 20, 0, 0, 4, 40, 12, 5, 8, 60, 20, 0, 12];
+      const result = correctPostStroke(input({ packets, renderedPoints, stabilization }));
+      const secondStart = packets.findIndex((packet, index) => index > 0 && packet.phase === 2);
+      const expectedGeometry = [packets.slice(0, secondStart), packets.slice(secondStart)].flatMap(
+        (group) => {
+          const separate = correctPostStroke(
+            input({
+              packets: group,
+              stabilization,
+              renderedPoints: group.flatMap((packet) => [
+                packet.x,
+                packet.y,
+                1,
+                packet.t - group[0].t,
+              ]),
+            }),
+          ).points;
+          return Array.from({ length: separate.length / 4 }, (_, index) => ({
+            x: separate[index * 4],
+            y: separate[index * 4 + 1],
+          }));
+        },
+      );
+      expect(result.points).toEqual(transferStrokeAttributes(expectedGeometry, renderedPoints));
+      expect(result.sourceNodeCount).toBe(packets.length);
+      expect(result.points.slice(0, 4)).toEqual([0, 0, 0, 0]);
+      expect(result.points.slice(-2)).toEqual([0, 12]);
+    }
+  });
+
+  it("preserves a zero-length tap and a one-packet stroke deliberately", () => {
+    for (const packets of [
+      [{ x: 3, y: 7, pressure: 0.5, t: 10, phase: 2 as const }],
+      [
+        { x: 3, y: 7, pressure: 0.5, t: 10, phase: 2 as const },
+        { x: 3, y: 7, pressure: 0, t: 20, phase: 3 as const },
+      ],
+    ]) {
+      const source = input({ packets, renderedPoints: [3, 7, 2, 0] });
+      expect(correctPostStroke(source).points).toEqual([3, 7, 2, 0]);
+    }
+  });
+
+  it("rejects malformed packets, unordered rendering times and an unsupported correction strength", () => {
+    expect(() =>
+      correctPostStroke(input({ packets: [{ x: NaN, y: 0, pressure: 1, t: 0, phase: 2 }] })),
+    ).toThrow(PostCorrectionError);
+    expect(() => correctPostStroke(input({ renderedPoints: [0, 0, 1, 5, 1, 0, 1, 3] }))).toThrow(
+      PostCorrectionError,
+    );
+    expect(() =>
+      correctPostStroke(input({ settings: { ...FIRST_POST_CORRECTION, strength: 41 } })),
+    ).toThrow(PostCorrectionError);
+  });
+});
+
+describe("Croquis width and time transfer", () => {
+  it("interpolates existing widths and elapsed times by normalized distance while preserving endpoints exactly", () => {
+    expect(
+      transferStrokeAttributes(
+        [
+          { x: 0, y: 5 },
+          { x: 5, y: 5 },
+          { x: 10, y: 5 },
+        ],
+        [0, 0, 2, 0, 4, 0, 6, 8, 8, 0, 4, 20],
+      ),
+    ).toEqual([0, 5, 2, 0, 5, 5, 6, 8, 10, 5, 4, 20]);
+  });
+
+  it("uses point order for a zero-length corrected path and retains the full elapsed interval", () => {
+    expect(
+      transferStrokeAttributes(
+        [
+          { x: 3, y: 7 },
+          { x: 3, y: 7 },
+          { x: 3, y: 7 },
+        ],
+        [0, 0, 2, 0, 8, 0, 4, 20],
+      ),
+    ).toEqual([3, 7, 2, 0, 3, 7, 3, 10, 3, 7, 4, 20]);
+  });
+});
diff --git a/apps/frontend/src/sticker-creation/canvas/post-correction/core.ts b/apps/frontend/src/sticker-creation/canvas/post-correction/core.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1370225682a3085f95513c7545f65de9834997df
--- /dev/null
+++ b/apps/frontend/src/sticker-creation/canvas/post-correction/core.ts
@@ -0,0 +1,335 @@
+import type { PostCorrectionSettings } from "./settings.ts";
+import { PostCorrectionError } from "./errors.ts";
+import { PostMovement, createPostInputRecord } from "./input.ts";
+import { QuadraticSourceBuilder } from "./source.ts";
+import { convertPostSettings, type Point } from "./reference.ts";
+import { runOrdinaryPost } from "./pipeline.ts";
+import { createPostEvaluatorConstructorConfig, evaluatePostEndpoint } from "./evaluator.ts";
+import { sampleSplineNodes } from "./spline-context.ts";
+import { MAX_POST_POINTS as MAX_POINTS, validatePostCorrectionPoints } from "./validation.ts";
+
+/** Completed stabilization output in the stroke's fixed sheet coordinates. */
+export interface PostCorrectionPacket {
+  x: number;
+  y: number;
+  pressure: number;
+  t: number;
+  phase: 1 | 2 | 3;
+}
+export interface PostCorrectionInput {
+  packets: readonly PostCorrectionPacket[];
+  renderedPoints: readonly number[];
+  settings: PostCorrectionSettings;
+  magnificationFraction: number;
+  brushSize: number;
+  pointerType: string;
+  stabilization: number;
+}
+export interface PostCorrectionProgress {
+  stage: string;
+  before: number;
+  after: number;
+}
+export interface PostCorrectionResult {
+  points: number[];
+  sourceNodeCount: number;
+  correctedNodeCount: number;
+}
+
+const MAX_PACKETS = 10000;
+const CORE_DEADLINE_MS = 800;
+
+function ensure(condition: unknown, message: string): asserts condition {
+  if (!condition) throw new PostCorrectionError(message);
+}
+
+/** Croquis attribute transfer, separate from recovered native scalar/curve arithmetic. */
+export function transferStrokeAttributes(
+  geometry: readonly Point[],
+  renderedPoints: readonly number[],
+): number[] {
+  validatePostCorrectionPoints(renderedPoints);
+  ensure(
+    geometry.length >= 1 &&
+      geometry.length <= MAX_POINTS &&
+      geometry.every((point) => Number.isFinite(point.x) && Number.isFinite(point.y)),
+    "Post correction produced invalid or excessive sampled geometry.",
+  );
+  // A collapsed result needs two coincident records to retain both endpoint attributes.
+  const points =
+    geometry.length === 1 && renderedPoints.length > 4 ? [geometry[0], geometry[0]] : geometry;
+  const sourceDistance = [0],
+    outputDistance = [0];
+  for (let index = 4; index < renderedPoints.length; index += 4)
+    sourceDistance.push(
+      sourceDistance[sourceDistance.length - 1] +
+        Math.hypot(
+          renderedPoints[index] - renderedPoints[index - 4],
+          renderedPoints[index + 1] - renderedPoints[index - 3],
+        ),
+    );
+  for (let index = 1; index < points.length; index++)
+    outputDistance.push(
+      outputDistance[outputDistance.length - 1] +
+        Math.hypot(points[index].x - points[index - 1].x, points[index].y - points[index - 1].y),
+    );
+  const sourceLength = sourceDistance[sourceDistance.length - 1],
+    outputLength = outputDistance[outputDistance.length - 1];
+  ensure(
+    Number.isFinite(sourceLength) && Number.isFinite(outputLength),
+    "Post correction path distance exceeded its finite domain.",
+  );
+  const output: number[] = [];
+  let segment = 0;
+  for (let index = 0; index < points.length; index++) {
+    let width: number, time: number;
+    if (index === 0) {
+      width = renderedPoints[2];
+      time = renderedPoints[3];
+    } else if (index === points.length - 1) {
+      width = renderedPoints[renderedPoints.length - 2];
+      time = renderedPoints[renderedPoints.length - 1];
+    } else {
+      const progress =
+        outputLength > 0 ? outputDistance[index] / outputLength : index / (points.length - 1);
+      let fraction: number;
+      if (sourceLength > 0) {
+        const target = progress * sourceLength;
+        while (segment < sourceDistance.length - 2 && sourceDistance[segment + 1] <= target)
+          segment++;
+        const span = sourceDistance[segment + 1] - sourceDistance[segment];
+        fraction = span > 0 ? (target - sourceDistance[segment]) / span : 0;
+      } else {
+        const parameter = progress * (sourceDistance.length - 1);
+        segment = Math.floor(parameter);
+        fraction = parameter - segment;
+      }
+      const at = segment * 4,
+        next = Math.min(at + 4, renderedPoints.length - 4);
+      width =
+        renderedPoints[at + 2] + (renderedPoints[next + 2] - renderedPoints[at + 2]) * fraction;
+      time = Math.round(
+        renderedPoints[at + 3] + (renderedPoints[next + 3] - renderedPoints[at + 3]) * fraction,
+      );
+      time = Math.max(
+        output.at(-1) ?? time,
+        Math.min(time, renderedPoints[renderedPoints.length - 1]),
+      );
+    }
+    output.push(points[index].x, points[index].y, width, time);
+  }
+  return output;
+}
+
+export function correctPostStroke(
+  input: PostCorrectionInput,
+  onProgress?: (progress: PostCorrectionProgress) => void,
+): PostCorrectionResult {
+  const started = performance.now();
+  const checkTime = () =>
+    ensure(
+      performance.now() - started < CORE_DEADLINE_MS,
+      "Post correction exceeded its processing deadline.",
+    );
+  try {
+    validatePostCorrectionPoints(input.renderedPoints);
+    ensure(
+      input.packets.length >= 1 && input.packets.length <= MAX_PACKETS,
+      "Post correction requires between 1 and 10,000 completed packets.",
+    );
+    ensure(
+      Number.isInteger(input.settings.strength) &&
+        input.settings.strength >= 0 &&
+        input.settings.strength <= 40,
+      "Post-correction strength must be an integer from 0 through 40.",
+    );
+    ensure(
+      Number.isFinite(input.magnificationFraction) &&
+        input.magnificationFraction > 0 &&
+        Number.isFinite(input.brushSize) &&
+        input.brushSize > 0 &&
+        Number.isInteger(input.stabilization) &&
+        input.stabilization >= 0 &&
+        input.stabilization <= 100,
+      "Post correction received invalid scale, brush size, or stabilization strength.",
+    );
+    for (const packet of input.packets)
+      ensure(
+        [packet.x, packet.y, packet.pressure, packet.t].every(Number.isFinite) &&
+          packet.pressure >= 0 &&
+          packet.pressure <= 1 &&
+          Number.isSafeInteger(Math.trunc(packet.t)),
+        "Post correction received an invalid completed stabilization packet.",
+      );
+    const groups: { start: number; end: number; correct: boolean }[] = [];
+    let openStart: number | null = null;
+    const phaseError =
+      "Post correction requires each native group to have a start, zero or more moves, and a terminal phase sequence.";
+    for (let index = 0; index < input.packets.length; index++) {
+      const phase = input.packets[index].phase;
+      if (phase === 2) {
+        ensure(openStart === null, phaseError);
+        openStart = index;
+      } else {
+        ensure(phase === 1 || phase === 3, phaseError);
+        if (openStart === null) {
+          ensure(groups.length > 0, phaseError);
+          groups.push({ start: index, end: index + 1, correct: false });
+        } else if (phase === 3) {
+          groups.push({ start: openStart, end: index + 1, correct: true });
+          openStart = null;
+        }
+      }
+    }
+    ensure(openStart === null || input.packets.length === 1, phaseError);
+    const first = input.packets[0];
+    if (
+      input.settings.strength === 0 ||
+      input.packets.length === 1 ||
+      input.packets.every((packet) => packet.x === first.x && packet.y === first.y)
+    )
+      return {
+        points: [...input.renderedPoints],
+        sourceNodeCount: input.packets.length,
+        correctedNodeCount: input.packets.length,
+      };
+
+    const magnificationPercent = input.magnificationFraction * 100;
+    const magnificationFraction = magnificationPercent * 0.01;
+    const settings = convertPostSettings({
+      enabled: true,
+      k: input.settings.strength,
+      flag480: input.settings.adjustBySpeed,
+      scaleTolerance: input.settings.adjustByScale,
+      selector482: false,
+      fallbackRequested: false,
+      magnificationPercent,
+      priorFlag480: false,
+      priorSelector482: false,
+    });
+    ensure(settings !== null, "Post correction settings unexpectedly disabled processing.");
+    const evaluator = createPostEvaluatorConstructorConfig();
+    const geometry: Point[] = [];
+    let sourceNodeCount = 0,
+      correctedNodeCount = 0,
+      expandedNodeCount = 0,
+      sourceChecks = 0;
+    for (const group of groups) {
+      checkTime();
+      const first = input.packets[group.start];
+      if (!group.correct) {
+        // Croquis keeps idle release output already used by its brush. It has no
+        // phase-2 source path, so preserve the point without native source dispatch.
+        geometry.push({ x: first.x, y: first.y });
+        ensure(geometry.length <= MAX_POINTS, "Post correction exceeded its sampled-point limit.");
+        continue;
+      }
+      // Explicit Croquis profile: neutral sheet conversion, no angle/tilt/startup response.
+      const movement = new PostMovement(
+        {
+          enabled: true,
+          deviceType: input.pointerType === "pen" ? 4 : 1,
+          window: input.stabilization,
+          platform: 2,
+          magnificationFraction,
+          coordinateFactor: 1,
+          documentRatio: 1,
+        },
+        first,
+        BigInt(Math.trunc(first.t)),
+      );
+      const sourceRecord = (packet: PostCorrectionPacket, sourceIndex: number) =>
+        createPostInputRecord({
+          point: packet,
+          pressure: packet.pressure,
+          movement:
+            sourceIndex === group.start ? 0 : movement.update(packet, BigInt(Math.trunc(packet.t))),
+          sourceIndex,
+          tiltDegrees: 90,
+          bearingDegrees: 0,
+          rotationDegrees: 0,
+          startupPosition: 0,
+          startupLength: 0,
+          offset: { x: 0, y: 0 },
+          angleSource: "none",
+          reflect360: false,
+          reflect180: false,
+        });
+      const source = new QuadraticSourceBuilder(
+        sourceRecord(first, group.start),
+        {
+          deferFirstNode: false,
+          fadeScalar54: null,
+          cornerDetection: null,
+        },
+        MAX_PACKETS,
+      );
+      for (let index = group.start + 1; index < group.end; index++) {
+        checkTime();
+        const record = sourceRecord(input.packets[index], index);
+        if (input.packets[index].phase === 3) source.finish(record);
+        else source.append(record, magnificationFraction);
+      }
+      const original = source.snapshot();
+      onProgress?.({
+        stage: "source",
+        before: group.end - group.start,
+        after: original.nodes.length,
+      });
+      const corrected = runOrdinaryPost(
+        {
+          ...settings,
+          selector482: 0,
+          closedMode: 0,
+          nodes: original.nodes,
+          pathFlags: original.pathFlags,
+        },
+        {
+          pathParameter: input.brushSize * 0.5,
+          evaluator: (node, parameter) => evaluatePostEndpoint(node, parameter, evaluator),
+        },
+        {
+          maximumNodes: MAX_PACKETS - expandedNodeCount,
+          maximumSourceChecks: 1000000 - sourceChecks,
+          deadlineMilliseconds: Math.max(1, CORE_DEADLINE_MS - (performance.now() - started)),
+          onPass: (pass) =>
+            onProgress?.({ stage: pass.stage, before: pass.before, after: pass.after }),
+        },
+      );
+      sourceNodeCount += original.nodes.length;
+      correctedNodeCount += corrected.nodes.length;
+      expandedNodeCount += corrected.sourceNodes.length;
+      sourceChecks += corrected.sourceChecks;
+      checkTime();
+      const groupGeometryStart = geometry.length;
+      // Croquis rendering density: half a CSS pixel, with the recovered sampler's 256-point cap.
+      const density = 0.5 / magnificationFraction;
+      for (let index = 0; index + 1 < corrected.nodes.length; index++) {
+        checkTime();
+        const node = corrected.nodes[index];
+        const samples = sampleSplineNodes(node, corrected.nodes[index + 1], 0, density, 0, 1);
+        geometry.push(...(index === 0 ? samples : samples.slice(1)));
+        ensure(geometry.length <= MAX_POINTS, "Post correction exceeded its sampled-point limit.");
+      }
+      if (geometry.length === groupGeometryStart && corrected.nodes[0])
+        geometry.push(corrected.nodes[0].point);
+    }
+    const points = transferStrokeAttributes(geometry, input.renderedPoints);
+    checkTime();
+    onProgress?.({
+      stage: "complete",
+      before: sourceNodeCount,
+      after: correctedNodeCount,
+    });
+    return {
+      points,
+      sourceNodeCount,
+      correctedNodeCount,
+    };
+  } catch (error) {
+    if (error instanceof PostCorrectionError) throw error;
+    throw new PostCorrectionError(
+      `Post correction failed: ${error instanceof Error ? error.message : String(error)}`,
+    );
+  }
+}

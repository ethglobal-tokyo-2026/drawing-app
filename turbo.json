{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "compile": {
      "outputs": ["out/**", "cache/**"]
    },
    "@drawing-app/sticker-chain#test": {
      "dependsOn": ["compile"]
    },
    "@drawing-app/api#test": {
      "dependsOn": ["@drawing-app/sticker-chain#compile"]
    }
  }
}

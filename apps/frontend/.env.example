# Both optional, and read by the dev server only; builds always use the production LIFF app.
# VITE_LIFF_ID swaps in another LIFF app, e.g. one whose endpoint is a local server.
VITE_LIFF_ID=
# "off" logs in to real LINE on the dev server instead of LIFF Mock.
VITE_LIFF_MOCK=

# Builds read this one too: the frosted-sleeve image on LINE gift cards, at an immutable HTTPS URL.
# Cards go without one until it's set.
VITE_GIFT_CARD_HERO_URL=

# Both optional, and read by the dev server only; builds always use the production LIFF app.
# VITE_LIFF_ID swaps in another LIFF app, e.g. one whose endpoint is a local server.
VITE_LIFF_ID=
# "off" logs in to real LINE on the dev server instead of LIFF Mock.
VITE_LIFF_MOCK=
# "off" answers from this device's own data on the dev server, instead of the fixtures (made-up
# people, stickers and gift links such as /g/demo).
VITE_API_MOCK=

# Builds read this one too: "on" shows the developer slip, LINE's and Privy's details at the foot of
# the stat board. The dev server shows it unless it's "off".
VITE_DEV_SLIP=

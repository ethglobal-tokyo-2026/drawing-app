# Optional, and read by the dev server only; builds always use the production LIFF app.
# The app signs in to its server with real LINE, so the dev server needs a LIFF app whose endpoint is
# this dev server (an HTTPS tunnel such as ngrok). `pnpm dev` runs the API beside it, and the dev
# server proxies /api to it on port 8788.
VITE_LIFF_ID=

# Builds read this one too: the frosted-sleeve image on gift messages, at an immutable HTTPS URL.
# Gift messages go without one until it's set.
VITE_GIFT_MESSAGE_HERO_URL=

# Builds read this one too: "on" shows the developer slip, LINE's and Privy's details at the foot of
# the stat board. The dev server shows it unless it's "off".
VITE_DEV_SLIP=

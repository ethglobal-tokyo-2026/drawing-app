    "@noble/hashes": "^1.8.0",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.8",
    "viem": "2.56.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "esbuild": "0.28.2",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "~7.0.2",
    "vitest": "^5.0.1"

# The REST API's settings for `pnpm dev`. A gitignored .env beside this file overrides any of them, key by key.
# Dev only: the box makes its own session secret.
SESSION_SECRET=dev-only-session-secret-never-used-on-the-box
LINE_CHANNEL_ID=2011732197
# Relative to apps/api: the repo's gitignored data/, beside the local database.
IMAGE_DIR=../../data/images
# Where the API serves the sticker images, through the dev server. Without a CDN_BASE_URL, every image loads from here.
IMAGE_BASE_URL=http://localhost:5173/api/images
# Trusts the dev ID tokens LIFF Mock hands out for ?as=<name>, so anyone can sign in as anyone. LINE's own
# tokens still go to LINE. deploy.sh and deploy-api.sh keep it off the box.
DEV_SIGN_IN=on
STICKER_CHAIN_MODE=mock
# The Sui network, and the ticket shop's JPYC and payment contract on it: all public.
SUI_NETWORK=testnet
JPYC_COIN_TYPE=0xf239f4711b8b6e5331a24174905e8412df01e6fe81abcdaa2613f5aaf35a6496::jpy_coin::JPY_COIN
JPYC_DECIMALS=6
JPYC_PAYMENT_PACKAGE=0xce54032ee3ee017f6cc5bcb64393a246c2d1250717dc5c1963f6b4c578f70aa5
JPYC_PAYMENT_VAULT=0x5198edbb873bc4d2f139c97be8c18784f997f92be784a715ec0239bf2295b97c

# The chat menus' IDs, relative to apps/api. The chat menu and the giver's message are off under
# DEV_SIGN_IN; with real LINE, set LINE_MESSAGING_CHANNEL_ID and LINE_MESSAGING_CHANNEL_SECRET in .env.
LINE_CHAT_MENUS_FILE=../../deploy/line/menus.json
# The CDN cap runs only with FASTLY_API_TOKEN, FASTLY_SERVICE_ID and FASTLY_CAP_DICTIONARY_ID, as on the box
# (deploy/README.md's CDN).

# For real stickers and gifts on Sui, set STICKER_CHAIN_MODE=sui in the private .env, with its secrets:
# SUI_SERVER_PRIVATE_KEY (a suiprivkey1… key), SHINAMI_ACCESS_KEY, PRIVY_APP_ID and PRIVY_APP_SECRET.
# The stickers package's IDs are public, as deploy/publish-sui.mjs prints them, and the same as
# deploy/drawing-api.env's:
SUI_STICKER_PACKAGE=0xf9459a861fb5aa97ac6bb3e7542abe6096163ce05ec85e2ca2e2b0ca0696b505
SUI_STICKER_REGISTRY=0xed739960e58f9d638193ab7e9019ad5e91e236b594a85ee2c3347a48d41ac0f1
SUI_SERVER_CONFIG=0x4dd5f1a14ba0cbd80365b9a0921c46d5cdc8ea8ba1ef1abdfbb8ff383a96a85e
SUI_GIFT_ESCROW=0x4d6f33314377c79663d148d3234774c21129215eeeb7c7908808ce8e902fc6f7
# The box always runs sui: deploy-api.sh installs STICKER_CHAIN_MODE=sui there. Never commit real
# credentials.

# Real LINE through the LIFF CLI proxy (https://localhost:9443) serves images from there, so set this in .env:
#   IMAGE_BASE_URL=https://localhost:9443/api/images
